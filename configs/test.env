# 测试用 URL 配置（修改后重新跑 test-all.sh 即可）
#
# ⚠️ HTTP_URL 必须是「明文 HTTP 且返回 200」的地址。
# 原先用的 http://repo.openeuler.org/ 现在整站 308 跳转到 HTTPS,
# 而各测试断言的是 200,于是 6 个用例里有 5 个直接 FAIL。
# 这类上游变更随时可能再次发生 —— 根治办法是在 compose 里放一个本地 origin
# (nginx + 固定文件),让测试不依赖任何第三方站点,详见 README「本地 origin」一节。
HTTP_URL="http://mirrors.tuna.tsinghua.edu.cn/openeuler/"
HTTPS_URL="https://curl.se/download/curl-8.9.1.tar.gz"
HTTPS_CACHE_URL="https://repo.openeuler.org/openEuler-23.03/debuginfo/aarch64/Packages/bcc-debuginfo-0.26.0-1.oe2303.aarch64.rpm"
